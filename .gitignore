# Build output.
# These MUST stay anchored with a leading slash: a bare `kopicode` pattern matches
# any path component with that name, which silently ignores cmd/kopicode/ and its
# source along with it.
/bin/
/dist/
/kopicode
/kopibench

# The real credential file (KAN-910). Anchored for the same reason as above: a bare
# `.env` pattern would also match any *directory* named .env, which does not exist
# here today but is exactly the kind of thing this file's own header warns about.
# .env.example is the committed template; this is the one that must never be.
/.env

# Go
*.test
*.out
coverage.txt

# kopicode local data: session journals, blobs, locks, throwaway indexes
.kopicode/

# Bench results and scratch worktrees
/bench/results/
/bench/.worktrees/

# Python corpus tasks run their oracle with PYTHONDONTWRITEBYTECODE=1, so this
# should never appear. It is here for the run that forgets to set it, because a
# __pycache__ inside a task tree changes the diff that run is scored on.
__pycache__/

# Recorded provider fixtures are committed, but never raw captures
*.raw.json

# Editors / OS
.DS_Store
.idea/
.vscode/
